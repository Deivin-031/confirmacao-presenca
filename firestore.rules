rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'davymagalhaes244@gmail.com';
    }
    function isGuest() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    match /families/{familyId} {
      allow list: if isAdmin();
      // O código secreto do convite é o ID do documento. Não compartilhe fora da família.
      allow get: if isAdmin() || (isGuest() && familyId.matches('[a-f0-9]{48}'));
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isGuest()
        && familyId.matches('[a-f0-9]{48}')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'attending', 'updatedAt'])
        && request.resource.data.status in ['yes', 'no']
        && request.resource.data.attending is list
        && request.resource.data.attending.size() <= resource.data.members.size()
        && request.resource.data.attending.hasOnly(resource.data.members)
        && (
          (request.resource.data.status == 'yes' && request.resource.data.attending.size() > 0)
          || (request.resource.data.status == 'no' && request.resource.data.attending.size() == 0)
        )
        && request.resource.data.updatedAt == request.time
      );
    }
  }
}
